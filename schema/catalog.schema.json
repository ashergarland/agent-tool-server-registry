{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ashergarland/agent-tool-server-registry/main/schema/catalog.schema.json",
  "title": "Agent tool server catalog",
  "description": "Broad discovery and lifecycle information for the ashergarland agent-tool-server source repositories.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "servers"],
  "properties": {
    "$schema": { "const": "./schema/catalog.schema.json" },
    "schemaVersion": { "const": 1 },
    "servers": {
      "type": "array",
      "items": { "$ref": "#/$defs/server" }
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "summary",
        "repository",
        "lifecycle",
        "categories"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^agent-tool-server-[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/ashergarland/agent-tool-server-[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "lifecycle": {
          "enum": [
            "scaffold",
            "development",
            "active",
            "deprecated",
            "archived"
          ]
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 40
          }
        },
        "deprecation": { "$ref": "#/$defs/deprecation" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "lifecycle": { "const": "deprecated" } },
            "required": ["lifecycle"]
          },
          "then": {
            "properties": { "deprecation": { "$ref": "#/$defs/deprecation" } },
            "required": ["deprecation"]
          },
          "else": {
            "not": {
              "properties": {
                "deprecation": { "$ref": "#/$defs/deprecation" }
              },
              "required": ["deprecation"]
            }
          }
        }
      ]
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "replacement": {
          "type": "string",
          "pattern": "^agent-tool-server-[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        }
      }
    }
  }
}
