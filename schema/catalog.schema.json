{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ashergarland/agent-tool-server-registry/main/schema/catalog.schema.json",
  "title": "Agent tool server catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "catalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "server-entry.schema.json"
      }
    }
  }
}
