          {
            "name": "EBAY_CLIENT_ID",
            "required": true,
            "secret": true,
            "description": "eBay application client identifier."
          },
          {
            "name": "EBAY_CLIENT_SECRET",
            "required": true,
            "secret": true,
            "description": "eBay application client secret."
          },
          {
            "name": "EBAY_ENVIRONMENT",
            "required": true,
            "secret": false,
            "description": "Selects the eBay production or sandbox environment."
          }
        ]
      },
      "capabilities": {
        "tools": [
          {
            "name": "ebay_compare_listings",
            "summary": "Compare active listings without making a recommendation.",
            "safety": "low",
            "behavior": "read-only",
            "consequential": false,
            "availability": "available"
          },
          {
            "name": "ebay_find_similar_listings",
            "summary": "Find active comparable listings using documented identifiers and keywords.",
            "safety": "low",
            "behavior": "read-only",
            "consequential": false,
            "availability": "available"
          },
          {
            "name": "ebay_get_listing",
            "summary": "Retrieve structured listing data from an eBay URL or item ID.",
            "safety": "low",
            "behavior": "read-only",
            "consequential": false,
            "availability": "available"
          },
          {
            "name": "ebay_search_listings",
            "summary": "Search active eBay listings with bounded filters.",
            "safety": "low",
            "behavior": "read-only",
            "consequential": false,
            "availability": "available"
          }
        ]
      },
      "operations": {
        "leastPrivilege": "not-documented",
        "scopeAllowLists": "not-documented",
        "mutationsDisabledByDefault": true,
        "explicitMutationConfirmation": "not-documented",
        "dryRun": "not-documented",
        "auditLogging": "not-documented",
        "credentialPersistence": "memory-only",
        "inputValidation": true,
        "outputValidation": true,
        "rateLimiting": true,
        "healthMonitoring": true
      },
      "provenance": {
        "sourceMetadata": {
          "kind": "readme",
          "location": "README.md"
        },
        "lastVerifiedCommit": "4ae9f531a15ef8de1c2763104f912214bfb8711d",
        "reviewStatus": "mismatch",
        "notes": [
          "The source repository does not yet contain the required server.json.",
          "The source package name, repository URL, README title, CI badge, service name, and security link still use the former chatgpt-ebay name.",
          "No published package, immutable container release, official MCP registration, Docker catalog registration, or stable hosted endpoint was verified."
        ]
      }
    },
