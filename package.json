{
  "name": "agent-tool-server-registry",
  "version": "0.1.0",
  "description": "Canonical curated catalog for the ashergarland agent-tool-server family",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "catalog:check": "tsx src/cli.ts catalog-check",
    "catalog:generate": "tsx src/cli.ts generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsx src/cli.ts validate",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run validate && npm run catalog:check",
    "verify:online": "tsx src/cli.ts verify-online"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashergarland/agent-tool-server-registry.git"
  },
  "keywords": [
    "mcp",
    "registry",
    "agent-tools"
  ],
  "author": "ashergarland",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
