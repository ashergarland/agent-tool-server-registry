{
  "schemaVersion": "1.0.0",
  "id": "agent-tool-server-azure",
  "name": "Azure Agent Tool Server",
  "description": "A constrained server for inspecting, diagnosing, and operating Azure resources.",
  "version": "0.1.0",
  "lifecycle": "development",
  "repository": "https://github.com/ashergarland/agent-tool-server-azure",
  "license": "MIT",
  "maintainer": "@ashergarland",
  "categories": ["cloud-operations", "developer-tools"],
  "tags": ["azure", "diagnostics", "infrastructure"],
  "interfaces": {
    "transports": ["stdio", "openapi-http"],
    "hosting": "self-hosted",
    "endpoints": {
      "openApiUrlTemplate": "https://{host}/openapi.json",
      "healthUrlTemplate": "https://{host}/health"
    },
    "authentication": [
      "api-key",
      "bearer-token",
      "entra-jwt",
      "managed-identity"
    ],
    "requiredConfiguration": [
      {
        "name": "API_KEYS",
        "required": true,
        "secret": true,
        "description": "Inbound API keys when API-key authentication is selected."
      },
      {
        "name": "AUTH_MODE",
        "required": true,
        "secret": false,
        "description": "Selects API-key, Entra JWT, or local disabled authentication."
      },
      {
        "name": "AZURE_ALLOWED_RESOURCE_GROUPS",
        "required": false,
        "secret": false,
        "description": "Optional resource-group scope allow-list."
      },
      {
        "name": "AZURE_SUBSCRIPTION_IDS",
        "required": false,
        "secret": false,
        "description": "Optional subscription scope allow-list."
      },
      {
        "name": "ENTRA_AUDIENCE",
        "required": false,
        "secret": false,
        "description": "Required audience when Entra JWT authentication is selected."
      },
      {
        "name": "ENTRA_TENANT_ID",
        "required": false,
        "secret": false,
        "description": "Required tenant identifier when Entra JWT authentication is selected."
      }
    ]
  },
  "capabilities": {
    "tools": [
      {
        "name": "azure_list_subscriptions",
        "summary": "List subscriptions visible to the server.",
        "safety": "low",
        "behavior": "read-only",
        "consequential": false,
        "availability": "available"
      },
      {
        "name": "azure_list_resource_groups",
        "summary": "List resource groups in an allowed subscription.",
        "safety": "low",
        "behavior": "read-only",
        "consequential": false,
        "availability": "available"
      },
      {
        "name": "azure_search_resources",
        "summary": "Search resources with structured filters.",
        "safety": "low",
        "behavior": "read-only",
        "consequential": false,
        "availability": "available"
      },
      {
        "name": "azure_get_resource",
        "summary": "Retrieve one Azure resource and its properties.",
        "safety": "moderate",
        "behavior": "read-only",
        "consequential": false,
        "availability": "available"
      },
      {
        "name": "azure_run_graph_query",
        "summary": "Run a read-only Azure Resource Graph query.",
        "safety": "moderate",
        "behavior": "read-only",
        "consequential": false,
        "availability": "available"
      },
      {
        "name": "azure_get_activity_log",
        "summary": "Retrieve recent control-plane activity.",
        "safety": "moderate",
        "behavior": "read-only",
        "consequential": false,
        "availability": "available"
      },
      {
        "name": "azure_get_resource_metrics",
        "summary": "Retrieve Azure Monitor metric time series.",
        "safety": "low",
        "behavior": "read-only",
        "consequential": false,
        "availability": "available"
      },
      {
        "name": "azure_list_unhealthy_resources",
        "summary": "List resources reported as unhealthy.",
        "safety": "low",
        "behavior": "read-only",
        "consequential": false,
        "availability": "available"
      },
      {
        "name": "azure_restart_virtual_machine",
        "summary": "Restart an allowed virtual machine.",
        "safety": "high",
        "behavior": "mutation",
        "consequential": true,
        "availability": "available"
      },
      {
        "name": "azure_start_virtual_machine",
        "summary": "Start an allowed stopped virtual machine.",
        "safety": "high",
        "behavior": "mutation",
        "consequential": true,
        "availability": "available"
      },
      {
        "name": "azure_restart_web_app",
        "summary": "Restart an allowed App Service or Function App.",
        "safety": "high",
        "behavior": "mutation",
        "consequential": true,
        "availability": "available"
      },
      {
        "name": "azure_tag_resource",
        "summary": "Merge tags onto an allowed resource.",
        "safety": "moderate",
        "behavior": "mutation",
        "consequential": true,
        "availability": "available"
      }
    ]
  },
  "operations": {
    "leastPrivilege": true,
    "scopeAllowLists": true,
    "mutationsDisabledByDefault": true,
    "explicitMutationConfirmation": true,
    "dryRun": true,
    "auditLogging": true,
    "credentialPersistence": "none",
    "inputValidation": true,
    "outputValidation": true,
    "rateLimiting": true,
    "healthMonitoring": true
  },
  "provenance": {
    "sourceMetadata": {
      "kind": "readme",
      "location": "README.md"
    },
    "lastVerifiedCommit": "2ff1cea5e563ccc9175b9f726df22f38baed05e3",
    "reviewStatus": "mismatch",
    "notes": [
      "The source repository does not yet contain the required server.json.",
      "No published package, immutable container release, official MCP registration, Docker catalog registration, or stable hosted endpoint was verified."
    ]
  }
}
